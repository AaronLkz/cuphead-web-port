    key: AchievementARankWorld1Desc
    category: 44
    description: Obtain an A-Rank or higher on all bosses in world 1
    translations:
    - hasImage: 0
      text: Obtain an A-Rank or higher on all bosses in Inkwell Isle I
      fonts:
