        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Eu bolei uma nova e incrível receita!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: 「ワタクシはすでに驚くべき新メニューを編み出したのですから！」
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
