        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: Hört! Ihr habt großes Können bewiesen!
