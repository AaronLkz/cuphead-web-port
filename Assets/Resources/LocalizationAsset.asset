      text: Auf Kosten deiner Angriffskraft\ngibt's zwei zusätzliche Trefferpunkte.
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
