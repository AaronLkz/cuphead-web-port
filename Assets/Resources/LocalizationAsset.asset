    key: TutorialCoinInstructions
    category: 32
    description: IN-GAME, https://drive.google.com/file/d/1eioOKTlZjJRHP0wdw6nT8pohEP4MW9qh/view?usp=sharing
    translations:
    - hasImage: 0
      text: COLLECT COINS TO PURCHASE\nITEMS FROM THE SHOP.
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: RÉCUPÉREZ DES PIÈCES POUR ACHETER DES OBJETS AU MAGASIN.
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: RACCOGLI MONETE PER ACQUISTARE OGGETTI NEL NEGOZIO.
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: SAMMLE MÜNZEN, UM\nGEGENSTÄNDE IM SHOP ZU KAUFEN.
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: RECOGE MONEDAS PARA COMPRAR\nOBJETOS EN LA TIENDA.
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: RECOGE MONEDAS PARA COMPRAR\nOBJETOS EN LA TIENDA.
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
