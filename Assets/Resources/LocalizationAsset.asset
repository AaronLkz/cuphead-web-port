        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: 무기들이 모든 적에게 똑같은 효과를 발휘할 거라고 생각했다면, 틀렸어!
      fonts:
