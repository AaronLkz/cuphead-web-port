  - m_ID: 688
    m_Depth: 0
    key: TutorialParryInstructions
    category: 32
    description: IN-GAME
    translations:
    - hasImage: 0
      text: PRESS AT ANY TIME TO NULLIFY\nOR INTERACT WITH PINK OBJECTS.
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 5
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: APPUYEZ À TOUT MOMENT POUR\nNEUTRALISER LES OBJETS ROSES\nOU INTERAGIR AVEC EUX.
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 5
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: PREMI QUANDO VUOI PER NEUTRALIZZARE OGGETTI ROSA O INTERAGIRE CON LORO.
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 5
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: JEDERZEIT DRÜCKEN, UM DIE PINKEN OBJEKTE ZU\nANNULLIEREN ODER MIT IHNEN ZU INTERAGIEREN.
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 5
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: PULSA EN CUALQUIER MOMENTO PARA ANULAR\nO INTERACTUAR CON LOS OBJETOS DE COLOR ROSA.
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 5
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: PRESIONA EN CUALQUIER MOMENTO PARA ANULAR\nO INTERACTUAR CON LOS OBJETOS DE COLOR ROSA.
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 5
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: 언제든 눌러서 핑크색 물체를\n무력화할 수 있어요.
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 32
        tmpFontType: 14
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
