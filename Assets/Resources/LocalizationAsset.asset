        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: Vedere tutte le sue buone opere mi dà una prospettiva diversa sulle cose!
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: Diese vielen guten Taten haben mir eine ganz neue Sicht auf die Dinge verliehen!
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: ¦Haber presenciado tantos actos de bondad me ha permitido analizar las cosas desde una nueva perspectiva!
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: ¦Haber presenciado tantos actos de bondad me ha permitido analizar las cosas desde una nueva perspectiva!
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: 그런 활약상을 보니 세상을 새로운 관점에서 보게 됐지 뭐야!
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
