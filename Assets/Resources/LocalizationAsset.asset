        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: Danke, Leute! Ich wusste doch, dass es einen schnelleren Weg über die Insel gibt!
