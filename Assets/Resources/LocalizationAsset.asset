    translationsMugman: []
    enabled: 0
  - m_ID: 551
    m_Depth: 0
    key: ElderKettle_W0_S1_Initial_Line10_B
    category: 27
    description: IN-GAME
    translations:
    - hasImage: 0
      text: Now go to my writing desk and use the mystical inkwell there.
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
