      text: In der Demo ist nur der Singleplayer-Modus verfügbar. Die Vollversion enthält einen 2-Spieler-Koop-Modus.
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
