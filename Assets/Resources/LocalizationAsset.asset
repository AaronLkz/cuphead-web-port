      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: ДОБУДЬ ИНГРЕДИЕНТ НА ОБЫЧНОЙ СЛОЖНОСТИ
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 7
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: ABY ZDOBYĆ CYROGRAF, SPRÓBUJ W TRYBIE ZWYKŁYM
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 7
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: JOGUE O MODO NORMAL E RECEBA UM INGREDIENTE
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 7
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: レギュラーモードにチャレンジして材料をゲットしよう！
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 17.11
        tmpFontType: 27
        charSpacing: 0
