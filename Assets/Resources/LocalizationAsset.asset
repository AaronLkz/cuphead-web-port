    translationsMugman: []
    enabled: 0
  - m_ID: 2096
    m_Depth: 0
    key: dlc_intro_cinematic_0007
    category: 26
    description: 'Spoken by Cuphead, inquisitive / demanding. In this scene, characters are running after Ms. Chalice as she beckons them. '
    translations:
    - hasImage: 0
      text: '"What:s going on here!? Everything:s gone topsy-turvy!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Mais qu:est-ce qui se passe_? Tout est chamboulé, d:un seul coup_!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Che succede qui? È finito tutto sottosopra!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Was geht hier vor!? Alles geht drunter und drüber!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"¡¿Qué está pasando aquí?! ¡Está todo patas arriba!".'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"¡¿Qué está pasando aquí?! ¡Está todo patas arriba!".'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"이게 어떻게 된 거야!? 전부 뒤죽박죽이잖아!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: «Что происходит вообще? Все пошло кувырком!»
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Co tu się dzieje?! Wszystko się pomerdało!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Que que tá acontecendo?! Isso aqui tá uma loucura!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: 「一体全体どうなってんだ？ さっぱり訳がわかんないよ！」
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: “乱了套了！到底是怎么了？！”
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    translationsCuphead: []
    translationsMugman: []
    enabled: 0
  - m_ID: 2097
    m_Depth: 0
    key: dlc_intro_cinematic_0008
    category: 26
    description: 'Spoken by Ms. Chalice '
    translations:
    - hasImage: 0
      text: '"Follow me, boys! I can explain everything."'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Suivez-moi, les garçons_! Je vais tout vous expliquer."'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Seguitemi, ragazzi! Posso spiegarvi tutto".'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Folgt mir, Jungs! Ich kann euch alles erklären."'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"¡Venid conmigo, chicos! Os lo explicaré todo...".'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"¡Vengan conmigo, chicos! Les explicaré todo...".'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"따라와, 얘들아! 내가 다 설명해 줄게."'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: «За мной, мальчики, я вам все объясню».
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Za mną, chłopcy! Wszystko wyjaśnię".'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Sigam-me, meninos! Vou explicar tudo."'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: 「二杯ともついてきて！みんな説明してあげるから。」
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: “你们俩，快跟上！我慢慢解释给你们听。”
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    translationsCuphead: []
    translationsMugman: []
    enabled: 0
  - m_ID: 2098
    m_Depth: 0
    key: dlc_intro_cinematic_0009
    category: 26
    description: Spoken by Ms. Chalice, as she arrives at a Bakery door
    translations:
    - hasImage: 0
      text: '"For ages, I:ve been trying to find a way to escape the astral plane, but nothing worked..."'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Cela fait une éternité que je tente d:échapper au plan astral, mais rien n:a jamais fonctionné..."'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Per anni ho cercato il modo di fuggire dal piano astrale, ma niente aveva mai funzionato..."'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Ich versuche schon eine Ewigkeit, aus der Astralebene zu entkommen, aber vergeblich ..."'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Durante años, he estado buscando formas de huir del plano astral, pero nada funcionaba...".'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Durante años, he estado buscando formas de huir del plano astral, pero nada funcionaba...".'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"난 오랫동안 영혼 세계에서 탈출할 방법을 찾아 헤맸지만, 아무것도 소용이 없었어..."'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: «Сотни лет я пыталась выбраться из астрала... все перепробовала... и все впустую...»
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Od wieków próbowałam uciec z wymiaru astralnego, ale żaden sposób nie działał..."'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Faz séculos que eu tento achar um jeito de fugir do plano astral, mas nada funcionou..."'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: 「すっごく長い間、わたしは幽界から抜け出す方法を\n探していたけれど、見つけることが出来なかった…」
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: “我一直在想办法逃出星界。可是试了很久很久，\n怎么也出不去……”
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    translationsCuphead: []
    translationsMugman: []
    enabled: 0
  - m_ID: 2099
    m_Depth: 0
    key: dlc_intro_cinematic_0010
    category: 26
    description: Continued, by Ms. Chalice in front of Bakery
    translations:
    - hasImage: 0
      text: '"...until now! Boys, let me introduce you to..."'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Du moins, jusqu:à aujourd:hui_! Les garçons, permettez-moi de vous présenter..."'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Fino a ora! Ragazzi, vi presento..."'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"... bis jetzt! Jungs, ich möchte euch gerne jemanden vorstellen ..."'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"¡Hasta ahora! Chicos, permitid que os presente...".'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"¡Hasta ahora! Chicos, permítanme presentarles...".'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"…지금까지는 말이지! 자, 소개할게..."'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: «...но вот сейчас я нашла способ! Мальчики, позвольте вам представить...»
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Udało się dopiero teraz! Chłopcy, przedstawiam wam..."'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"...até agora! Meninos, apresento a vocês..."'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: 「...今までは、ね！では、あなたたちにご紹介します…」
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: “……不过，这次就不一样了！\n来，我给你们俩介绍一下这位……”
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    translationsCuphead: []
    translationsMugman: []
    enabled: 0
  - m_ID: 2100
    m_Depth: 0
    key: dlc_intro_cinematic_0011
    category: 26
    description: 'Spoken by Ms. Chalice, introducing Chef Saltbaker. '
    translations:
    - hasImage: 0
      text: '"...Chef Saltbaker! The greatest chef in all the lands!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"... le chef Lasalière_! Le plus grand cuisinier au monde_!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Pinzimonio Salieri! Il più grande cuoco che ci sia!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"... Konditormeister Salzbäcker! Das ist der beste Konditor im ganzen Land!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"¡El Chef Saleroso! ¡El mejor chef del mundo mundial!".'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"¡Al Chef Saleroso! ¡El mejor chef del mundo mundial!".'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"...솔트베이커 주방장이야! 세계 최고의 주방장이지!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: «...Шеф-повар Солонкин! Величайший кулинар во всем мире!»
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Solisława Tejziemskiego! Światowego arcymistrza kuchni!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"...o Chef Pitadinha! O maior cozinheiro do mundo!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: 「シェフ・ソルトベイカー! 世界一偉大な料理人よ！」
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: “……盐大厨！他是所有岛屿上最了不起的厨师！”
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    translationsCuphead: []
    translationsMugman: []
    enabled: 0
  - m_ID: 2101
    m_Depth: 0
    key: dlc_intro_cinematic_0012
    category: 26
    description: 'Spoken by Chef Saltbaker, noticing Ms. Chalice has transformed. '
    translations:
    - hasImage: 0
      text: '"Welcome friends, welcome to my bakery. Ah, Ms. Chalice! I see my cookie has worked wonders on you!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Bienvenue dans ma boulangerie_! Mme_Calice, je vois que mon biscuit vous a fait le plus grand bien_!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Benvenuti, amici, benvenuti nella mia panetteria. Ah, Chalice! Il mio frollino ha funzionato a meraviglia!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Willkommen in meiner Backstube. Ah, Fräulein Kelch! Wie ich sehe, hat mein Keks Wunder gewirkt!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Bienvenidos a mi panadería. ¡Anda, señorita Cáliz! ¡Veo que mi galletita ha hecho maravillas con usted!".'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Bienvenidos a mi panadería. ¡Vaya, señorita Cáliz! ¡Veo que mi galletita ha hecho maravillas con usted!".'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"어서 오렴, 친구들. 내 빵집에 잘 왔어. 아, 미스 챌리스! 내 쿠키가 효과가 있었던 모양이네!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: «Добро пожаловать в мою пекарню, друзья Золотой Чаши - мои друзья! Я смотрю, мое печенье сработало?»
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Witajcie, przyjaciele, w mojej piekarni! O, panna Czarka! Widzę, że moje ciacho zdziałało cuda!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Bem-vindos, amigos, à minha humilde padaria. Ah, Srta. Cálice! Vejo que meu biscoito funcionou direitinho!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: 「我がパティスリーへようこそ、皆さん。おや、チャリスさん！\nワタクシのクッキーの効果は絶大なようですな！」
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: “欢迎你们来到我的面包房！啊，是圣杯小姐！\n看来我烤的小甜饼效果不错啊！”
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    translationsCuphead: []
    translationsMugman: []
    enabled: 0
  - m_ID: 2102
    m_Depth: 0
    key: dlc_intro_cinematic_0013
    category: 26
    description: 'Spoken by Ms. Chalice as she begins to transform back into a ghost. Note: similary to many expressions, "Oh My Stars!" is just a 30s phrase expressing surprise; feel free to find an equivalent, or translate literally if it makes sense in your language) '
    translations:
    - hasImage: 0
      text: '"Oh my stars!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Oh, par les étoiles_!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Oh, per tutte le stelle!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Oh, bei den Sternen!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"¡Ay, mis estrellas!".'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"¡Ay, mis estrellas!".'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"어머, 세상에!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: «Ох, звездочки мои!»
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"O, kurza melodia!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Minha nossa!"'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: 「あらま、びっくり仰天！」
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: “天呐！”
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    translationsCuphead: []
    translationsMugman: []
    enabled: 0
  - m_ID: 2103
    m_Depth: 0
    key: dlc_intro_cinematic_0014
    category: 26
    description: 'Spoken by Chalice after transforming back into a ghost. '
    translations:
    - hasImage: 0
      text: '"I:m a ghost again!"'
