      text: '{0} ya está asignado a {1}. ¿Quieres cambiar la asignación de este mando a {2}?'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '{0} ya está asignado a {1}. ¿Quieres cambiar la asignación de este control a {2}?'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
