        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: '"Właśnie opracowałem nowy, fantastyczny przepis!"'
      fonts:
        fontSize: 0
