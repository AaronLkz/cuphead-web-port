        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: ¦Ja! ¦Qué gran demostración de velocidad!
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: ¦Ja! ¦Qué gran demostración de velocidad!
