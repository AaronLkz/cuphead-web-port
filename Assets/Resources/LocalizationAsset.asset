  - m_ID: 855
    m_Depth: 0
    key: RemapControllerAssignmentConflictWindowMessage
    category: 34
    description: IN-GAME
    translations:
    - hasImage: 0
      text: '{0} is already assigned to {1}. Do you want to assign this controller to {2} instead?'
