      text: НАЖМИТЕ В ЛЮБОЕ ВРЕМЯ,ЧТОБЫ \nПАРИРОВАТЬ РОЗОВЫЕ ПРЕДМЕТЫ.
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 5
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: NACIŚNIJ W DOWOLNEJ CHWILI, ABY ZNEUTRALIZOWAĆ\nRÓŻOWY OBIEKT LUB GO UŻYĆ.
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 5
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: PRESSIONE A QUALQUER MOMENTO\nPARA ANULAR OU INTERAGIR\nCOM OBJETOS NA COR ROSA.
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 5
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: ピンク色のオブジェクトを\nパリィしたりチェックしたりする
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 26
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
