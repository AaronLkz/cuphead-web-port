      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: 이제 버튼을 누르거나 방향키를 움직여 {0}에 할당하세요.
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
