      text: BREVE PER SALTI BREVI -\nA LUNGO PER SALTI ALTI.
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
      spriteAtlasImageName:
    - hasImage: 0
      text: TIPPEN FÜR KURZEN SPRUNG -\nGEDRÜCKT HALTEN FÜR HOHEN SPRUNG.
