      text: '{0}에 할당할 키를 누르세요. 보조 키도 사용할 수 있습니다. 보조 키만 단독으로 할당하려면 1초간 누르고 있으세요.'
      fonts:
        fontSize: 0
        fontType: 0
        fontAssetSize: 0
        tmpFontType: 0
        charSpacing: 0
      image: {fileID: 0}
      spriteAtlasName:
