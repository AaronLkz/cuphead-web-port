              "lit": "echo \"==========================================================\"\necho \"CHECKING RUNNER / UNITY LOGS\"\necho \"==========================================================\"\nFOUND_LOG=\"\"\nfor candidate in $(sudo find /home/runner/.config /root/.config /tmp -name \"Editor.log\" 2>/dev/null) $(sudo find /home/runner /tmp -name \"Worker_*.log\" 2>/dev/null) /home/runner/.config/unity3d/Editor.log; do\n  if [ -s \"$candidate\" ]; then\n    FOUND_LOG=\"$candidate\"\n    echo \"Found candidate log: $candidate ($(wc -l < \"$candidate\") lines)\"\n    break\n  fi\ndone\nif [ -n \"$FOUND_LOG\" ]; then\n  echo \"--- ERRORS / WARNINGS / COMPILER MESSAGES ---\"\n  grep -E \"(error CS|Compilation failed|Exception|Build FAILED|Build SUCCEEDED|Assertion failed|SIGTRAP)\" \"$FOUND_LOG\" | head -n 100 || true\n  echo \"--- LAST 100 LINES OF BUILD LOG ---\"\n  tail -n 100 \"$FOUND_LOG\"\n  cp \"$FOUND_LOG\" unity-build.log || true\nelse\n  echo \"No log file found on runner.\"\nfi\n"
